# ═════════════════ مصدر المعرفة / Knowledge source ═════════════════
# خادم بيان يسحب الموقع بنفسه بمفتاح قراءة فقط.
# مستودع الموقع لا يحمل أياً من أسرار هذا الملف.
# Bayan's server pulls the site itself with a read-only key.
# The site repository holds none of the secrets in this file.
SITE_REPO_URL=https://github.com/PaxMemoria/paxmemoria-site.git
SITE_BRANCH=main
SITE_REPO=/srv/data/paxmemoria-site

# السرّ الوحيد الذي يملكه مستودع الموقع (GitHub secret: BAYAN_REINDEX_SECRET).
# أقصى ضرر تسريبه: إعادة فهرسة غير لازمة.
# The only secret the site repository holds (GitHub secret: BAYAN_REINDEX_SECRET).
# The worst harm from leaking it: an unnecessary reindex.
REINDEX_SECRET=

# ═════════════════ النماذج / Models ═════════════════
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANSWER_MODEL=claude-sonnet-5-5
# عمق التفكير low أو medium أو high / Thinking depth: low, medium or high
ANSWER_EFFORT=medium
# default يعيد رفض الأمان على نموذج بديل، off يعطّله / default reruns safety declines on a fallback model, off disables it
ANSWER_FALLBACK=default
# اختياري: إن ضُبط GEMINI_API_KEY يستمر بيان بالعمل عبر Gemini تلقائياً عند
# توقف Claude أو نفاد رصيده (أو يعمل به أساساً إن ضُبط ANSWER_MODEL=gemini-3.8-flash)
# Optional: if GEMINI_API_KEY is set, Bayan automatically continues via Gemini
# when Claude is down or out of credit (or uses it as primary if ANSWER_MODEL=gemini-3.8-flash)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# المتجهات ليست اختيارية عملياً: بدونها يُرفض كل سؤال مصاغ بكلمات غير
# كلمات موقعكم. راجع "لماذا المتجهات ضرورية" في README.
# Vectors are not optional in practice: without them, every question worded
# differently from your site is refused. See "Why vectors are necessary" in
# the README.
#
# local (الافتراضي): voyage-4-nano على الخادم نفسه، فلا يغادر أي سؤال
# الخادم، ولا يلزم مفتاح. يُنزَّل النموذج عند بناء صورة Docker، ويحتاج
# الخادم 4 GB ذاكرة متاحة لبيان على الأقل.
# voyage: خدمة Voyage عبر MongoDB Atlas بالمفتاح أدناه.
# local (the default): voyage-4-nano on the server itself, so no question
# leaves the server, and no key is needed. The model is downloaded when the
# Docker image is built, and the server needs at least 4 GB of memory
# available to Bayan.
# voyage: the Voyage service through MongoDB Atlas, with the key below.
EMBED_PROVIDER=local
# تغيير المزوّد أو النموذج أو الأبعاد يستلزم إعادة الفهرسة وإعادة المعايرة
# Changing the provider, the model or the dimensions requires reindexing
# and recalibrating
EMBED_DIM=1024
# أنوية المعالج للنموذج المحلي (0 يترك القرار لـ torch). يطابق BAYAN_CPUS
# CPU cores for the local model (0 leaves the choice to torch). Matches BAYAN_CPUS
EMBED_THREADS=2
# لـ EMBED_PROVIDER=voyage وحده: مفتاح من MongoDB Atlas ← AI Model APIs
# For EMBED_PROVIDER=voyage only: a key from MongoDB Atlas → AI Model APIs
VOYAGE_API_KEY=

# ═════════════════ الحارس / Guard ═════════════════
# معايَرة لـ voyage-4-nano بـ1024 بُعداً. تُضبط بعد ذلك من اللوحة
# Calibrated for voyage-4-nano at 1024 dimensions. Set from the dashboard after that
MIN_RELEVANCE=0.30
LEXICAL_THRESHOLD=0.60
TOP_K=6
MAX_TOOLS_LISTED=12
# التصحيح المعتمد يُستعمل حين يشبه سؤاله سؤالَ السائل بهذا القدر (معايَرة لـ voyage-4-nano)
# An approved correction is used when its question is this similar to the asker's (calibrated for voyage-4-nano)
CORRECTION_MIN_SIMILARITY=0.75
CORRECTIONS_PER_QUESTION=2

# ═════════════════ الهوية / Identity ═════════════════
BOT_NAME=بيان
ORG_NAME=باكس ميموريا
SITE_URL=https://paxmemoria.org
SHOW_SOURCES=true

# ═════════════════ تيليغرام / Telegram ═════════════════
TELEGRAM_BOT_TOKEN=
# إلزامي: بدونه يرفض الخادم كل تحديث من تيليغرام
# Required: without it the server refuses every update from Telegram
TELEGRAM_WEBHOOK_SECRET=

# ═════════════ واتساب + ماسنجر (Meta) / WhatsApp + Messenger (Meta) ═════════════
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v25.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=

# ═════════════════ الخادم واللوحة / Server and dashboard ═════════════════
PUBLIC_URL=https://bayan.paxmemoria.org
# المنفذ على 127.0.0.1 الذي يمرّر إليه nginx، وعدد الأنوية المسموحة
# The port on 127.0.0.1 that nginx forwards to, and the number of cores allowed
BAYAN_PORT=8000
BAYAN_CPUS=2
BAYAN_MEM=4g
# اللوحة على PUBLIC_URL/admin، وتبقى معطّلة حتى يُضبط الاثنان.
# كلمة المرور 12 حرفاً على الأقل، والسرّ 32 حرفاً على الأقل:
# The dashboard is at PUBLIC_URL/admin, and stays disabled until both are set.
# The password needs at least 12 characters, and the secret at least 32:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=
SESSION_SECRET=

RATE_LIMIT_MESSAGES=12
RATE_LIMIT_WINDOW=60
# أقصى أسئلة للمستخدم في أي 24 ساعة، لكل قناة (0 بلا حدّ). يُعدَّل من اللوحة
# Most questions per user in any 24 hours, per channel (0 means no limit).
# Adjustable from the dashboard
DAILY_LIMIT=10
# مدة حفظ الأسئلة بالأيام ثم الحذف، وتذكرها سياسة الخصوصية / Days questions are kept before deletion; stated in the privacy policy
MESSAGE_RETENTION_DAYS=30
# قنوات بثّ قائمة الفرص الأسبوعية للمشتركين (/subscribe). أضف whatsapp أو messenger بعد موافقة Meta.
# Channels that broadcast the weekly opportunities list to subscribers (/subscribe). Add whatsapp or messenger once Meta approves.
BROADCAST_CHANNELS=telegram

# الدخول إلى اللوحة بحساب Google من نطاق المنظمة (OAuth client من نوع Web في Google Cloud،
# وعنوان الرجوع: PUBLIC_URL/admin/auth/google/callback). ADMIN_EMAILS يدخل مديراً مباشرة.
# Dashboard sign-in with a Google account from the organisation's domain (a Web OAuth client in
# Google Cloud, redirect URI: PUBLIC_URL/admin/auth/google/callback). ADMIN_EMAILS sign in as admins.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
ALLOWED_EMAIL_DOMAIN=paxmemoria.org
ADMIN_EMAILS=
# عنوان طلبات الخصوصية في السياسة / Address for privacy requests in the policy
PRIVACY_CONTACT=GDPR@paxmemoria.org
HISTORY_TURNS=4
