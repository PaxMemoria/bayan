# ═════════════════ مصدر المعرفة ═════════════════
# خادم بيان يسحب الموقع بنفسه بمفتاح قراءة فقط.
# مستودع الموقع لا يحمل أياً من أسرار هذا الملف.
SITE_REPO_URL=https://github.com/PaxMemoria/paxmemoria-site.git
SITE_BRANCH=main
SITE_REPO=/srv/data/paxmemoria-site

# السرّ الوحيد الذي يملكه مستودع الموقع (GitHub secret: BAYAN_REINDEX_SECRET).
# أقصى ضرر تسريبه: إعادة فهرسة غير لازمة.
REINDEX_SECRET=

# ═════════════════ النماذج ═════════════════
ANTHROPIC_API_KEY=sk-ant-xxxxxxxx
ANSWER_MODEL=claude-sonnet-5-5

# ⚠ ليس اختيارياً عملياً: بدونه يُرفض كل سؤال مصاغ بكلمات غير كلمات
# موقعكم. راجع قسم "لماذا المتجهات ضرورية" في README.
# أضف وسيلة دفع في حساب Voyage: بدونها حدّ المعدل لا يكفي للفهرسة.
VOYAGE_API_KEY=
# تغييره يستلزم إعادة الفهرسة
EMBED_MODEL=voyage-4
EMBED_DIM=1024

# ═════════════════ الحارس ═════════════════
# قيمة ابتدائية: عايِرها بـ scripts/calibrate.py واضبطها من اللوحة
MIN_RELEVANCE=0.30
LEXICAL_THRESHOLD=0.60
TOP_K=6
MAX_TOOLS_LISTED=12

# ═════════════════ الهوية ═════════════════
BOT_NAME=بيان
ORG_NAME=باكس ميموريا
SITE_URL=https://paxmemoria.org
SHOW_SOURCES=true

# ═════════════════ تيليغرام ═════════════════
TELEGRAM_BOT_TOKEN=
# إلزامي: بدونه يرفض الخادم كل تحديث من تيليغرام
TELEGRAM_WEBHOOK_SECRET=

# ═════════════ واتساب + ماسنجر (Meta) ═════════════
META_APP_SECRET=
META_VERIFY_TOKEN=
META_GRAPH_VERSION=v21.0
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
MESSENGER_PAGE_TOKEN=

# ═════════════════ الخادم واللوحة ═════════════════
PUBLIC_URL=https://bayan.paxmemoria.org
# اللوحة على PUBLIC_URL/admin، وتبقى معطّلة حتى يُضبط الاثنان.
# كلمة المرور 12 حرفاً على الأقل، والسرّ 32 حرفاً على الأقل:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
ADMIN_PASSWORD=
SESSION_SECRET=

RATE_LIMIT_MESSAGES=12
RATE_LIMIT_WINDOW=60
HISTORY_TURNS=4
